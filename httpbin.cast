[81.363132, "i", "\u001b[200~# Define the capture helper\rcapture() { task=\"$1\"; shift; printf '\\nHTTPBIN_BEGIN http-7d8ab56c %s\\n' \"$task\"; \"$@\"; printf '\\nHTTPBIN_END http-7d8ab56c %s\\n' \"$task\"; }\r\r# 1. GET\rcapture GET curl -sS -H \"X-Exam-Tag: http-7d8ab56c\" \"https://httpbin.org/get?course=TDS&tag=http-7d8ab56c\"\r\r# 2. POST (Preserving JSON types)\rcapture POST curl -sS -H \"Content-Type: application/json\" -d '{\"tag\":\"http-7d8ab56c\",\"quantity\":17,\"active\":true}' https://httpbin.org/post\r\r# 3. FORM (PUT with URL-encoded form data)\rcapture FORM curl -sS -X PUT -d \"tag=http-7d8ab56c\" -d \"quantity=17\" https://httpbin.org/put\r\r# 4. AUTH (Bearer token authentication)\rcapture AUTH curl -sS -H \"Authorization: Bearer http-7d8ab56c\" https://httpbin.org/bearer\r\r# 5. REDIRECT (Follow redirect with -L)\rcapture REDIRECT curl -sS -L \"https://httpbin.org/redirect-to?url=https%3A%2F%2Fhttpbin.org%2Fget%3Ftag%3Dhttp-7d8ab56c\"\r\r# 6. COOKIES\r# Step A: Save cookie to cookie jar (outside capture)\rcurl -sS -c cookies.txt \"https://httpbin.org/cookies/set?exam=http-7d8ab56c\" > /dev/null\r\r# Step B: Read cookie jar and capture output\rcapture COOKIES curl -sS -b cookies.txt https://httpbin.org/cookies\r\r# Clean up cookie jar file (optional, within shell)\rrm -f cookies.txt\r\r# 7. STATUS (Discard body and print HTTP status code)\rcapture STATUS curl -sS -o /dev/null -w \"%{http_code}\" https://httpbin.org/status/400\r\r# Exit the recording session\rexit\u001b[201~"]
