[81.638315, "o", "\u001b[30A\r# 1. GET              \u001b[1B\rcapture GET curl -sS -H \"X-Exam-Tag: http-7d8ab56c\" \"https://httpbin.org/get?course=TDS&tag=http-7d8ab56c\"\u001b[1B\r\u001b[K\u001b[1B# 2. POST (Preserving JSON types)                                                                         \u001b[1B\rcapture POST curl -sS -H \"Content-Type: application/json\" -d '{\"tag\":\"http-7d8ab56c\",\"quantity\":17,\"active\":true}' https://httpbin.org/post             \u001b[1B\r\u001b[K\u001b[1B# 3. FORM (PUT with URL-encoded form data)\u001b[1B\rcapture FORM curl -sS -X PUT -d \"tag=http-7d8ab56c\" -d \"quantity=17\" https://httpbin.org/put\u001b[1B\r\u001b[K\u001b[1B# 4. AUTH (Bearer token authentication)                                                     \u001b[1B\rcapture AUTH curl -sS -H \"Authorization: Bearer http-7d8ab56c\" https://httpbin.org/bearer\u001b[1B\r\u001b[K\u001b[1B# 5. REDIRECT (Follow redirect with -L)                                                  \u001b[1B\rcapture REDIRECT curl -sS -L \"https://httpbin.org/redirect-to?url=https%3A%2F%2Fhttpbin.org%2Fget%3Ftag%3Dhttp-7d8ab56c\"                                   "]
[81.638452, "o", "   \u001b[1B\r\u001b[K\u001b[1B# 6. COOKIES\u001b[1B\r# Step A: Save cookie to cookie jar (outside capture)\u001b[1B\rcurl -sS -c cookies.txt \"https://httpbin.org/cookies/set?exam=http-7d8ab56c\" > /dev/null\u001b[1B\r\u001b[K\u001b[1B# Step B: Read cookie jar and capture output                                            \u001b[1B\rcapture COOKIES curl -sS -b cookies.txt https://httpbin.org/cookies\u001b[1B\r\u001b[K\u001b[1B# Clean up cookie jar file (optional, within shell)                \u001b[1B\rrm -f cookies.txt\u001b[1B\r\u001b[K\u001b[1B# 7. STATUS (Discard body and print HTTP status code)\u001b[1B\rcapture STATUS curl -sS -o /dev/null -w \"%{http_code}\" https://httpbin.org/status/400\u001b[1B\r\u001b[K\u001b[1B#                                                                                    \u001b[84D"]
